{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerfarm.app/schemas/gadget-v0.1.json",
  "title": "Powerfarm Gadget v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "powerfarm.app/v1alpha1" },
    "kind": { "const": "Gadget" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 63
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "maxLength": 64
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentic", "agents", "flows", "capabilities"],
      "properties": {
        "agentic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime"],
          "properties": {
            "runtime": { "const": "adk-js" }
          }
        },
        "agents": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": { "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
          "additionalProperties": { "$ref": "#/$defs/agent" }
        },
        "flows": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": { "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$" },
          "additionalProperties": { "$ref": "#/$defs/flow" }
        },
        "capabilities": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$" },
          "additionalProperties": { "$ref": "#/$defs/capability" }
        }
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "instruction", "capabilities"],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability"],
          "properties": {
            "capability": { "type": "string" }
          }
        },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 16000 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence"],
      "properties": {
        "sequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent"],
            "properties": {
              "agent": { "type": "string" }
            }
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "enum": ["model", "gatekeeper", "input", "code-executor"]
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 80
        }
      }
    }
  }
}
